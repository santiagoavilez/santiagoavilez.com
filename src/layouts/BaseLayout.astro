---
// Learn about using Astro layouts:
// https://docs.astro.build/en/core-concepts/layouts/

// Component Imports

import MainHead from "../components/MainHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ChatBot from "../components/ChatBot";
import "aos/dist/aos.css"; // You can also use <link> for styles
// ..

import Analytics from '@vercel/analytics/astro'
import  SpeedInsights  from "@vercel/speed-insights/astro"

import Icon, { type Props as IconProps } from "../components/Icon.astro";

const iconLinks: { label: string; href: string; icon: IconProps["icon"] }[] = [
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/santiago-avilez-ariza/",
    icon: "linkedin",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/santiago.avilez.dev/",
    icon: "instagram",
  },
  {
    label: "Tiktok",
    href: "https://www.tiktok.com/@santiago.avilez.dev",
    icon: "tiktok",
  },
  {
    label: "GitHub",
    href: "https://github.com/santiagoavilez",
    icon: "github-logo",
  },
];

interface Props {
  title?: string | undefined;
  description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <MainHead title={title} description={description} />
  </head>
  <body>
    <script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script is:inline>
      AOS.init({
        easing: "ease-in",
        delay: 100,
        once: true,
        mirror: true,
        duration: 450,
      });
    </script>

    <div class="flex min-h-svh flex-col">
      <Nav />
      <!-- <aside
        class="hidden absolute lg:flex flex-col w-10 top-1/3 translate-y-1/2 lg:text-3xl xl:text-4xl pl-2 xl:pl-10 gap-5 left-0"
      >
        {
          iconLinks.map(({ href, icon, label }) => (
            <a
              href={href}
              class="social  text-gray-400 hover:text-cerulean-600 z-10 hover:z-30 transition-all duration-200 transform hover:scale-110 w-full"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="sr-only nav">{label}</span>
              <Icon class="nav" icon={icon} />
            </a>
          ))
        }
      </aside> -->
      <div class="pt-20">
        <slot />
      </div>

      <Footer />
    </div>
    <ChatBot client:load />
    <SpeedInsights/>
    <Analytics />
    <script>
      import { initClarity, trackEvent } from "../lib/analytics";
      import { classifyLink, slug } from "../lib/linkEvents";

      initClarity();

      // Delegated click tracking: covers every CTA/link without touching each component.
      document.addEventListener("click", (event) => {
        try {
          if (!(event.target instanceof Element)) return;
          const link = event.target.closest("a");
          if (!link) return;

          if (link.dataset.track) {
            trackEvent(`${link.dataset.track}_${slug(link.dataset.trackProject ?? "unknown")}`);
            return;
          }

          const source = link.closest("nav")
            ? "nav"
            : link.closest("footer")
              ? "footer"
              : link.closest("[id]")?.id || "page";
          classifyLink(link.getAttribute("href") ?? "", location.origin, source).forEach(trackEvent);
        } catch {
          // Analytics must never break navigation.
        }
      });

      // Fire once per section the first time 10% of it is visible. The ratio is relative to the
      // section's own height, so a higher threshold would never fire for sections taller than the viewport.
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            sectionObserver.unobserve(entry.target);
            const section = (entry.target as HTMLElement).dataset.trackSection;
            if (section) trackEvent(`section_viewed_${slug(section)}`);
          }
        },
        { threshold: 0.1 }
      );
      document
        .querySelectorAll("[data-track-section]")
        .forEach((el) => sectionObserver.observe(el));
    </script>
    <script>
      // Add “loaded” class once the document has completely loaded.
      addEventListener("load", () => {
        document.documentElement.classList.add("loaded");
      });
    </script>
  </body>
</html>
